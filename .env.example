# Supabase (Project Settings > API). The service role key bypasses RLS: server side only, never in the frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe TEST mode keys only (sk_test_...). Live keys are refused unless ALLOW_LIVE_MODE=1.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Shared secret the finder and tipper agents send in the X-Agent-Key header.
AGENT_API_KEY=change-me-to-a-long-random-string

# Where Stripe onboarding and checkout send people back to.
FRONTEND_URL=http://localhost:3000

# Demo fallback that lets you credit a campaign without a payment. Leave off outside the hackathon.
ALLOW_DEV_FUNDING=0
ALLOW_LIVE_MODE=0

# Country for creator payout accounts (Stripe cross border rules apply if different from your platform).
CREATOR_COUNTRY=US
